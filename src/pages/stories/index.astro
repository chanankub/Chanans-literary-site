---
import { getCollection } from "astro:content";
import CommentHover from "../../components/CommentHover.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { filterPublished, sortByOrderThenTitle, withBase, entrySlug } from "../../lib/content";

const stories = sortByOrderThenTitle(filterPublished(await getCollection("stories")));
const groups = [
  {
    title: "לזכרם",
    slugs: ["etzel-yisrael-ba-sadna", "al-chaverut"],
  },
  {
    title: "ממואר",
    slugs: ["ha-givah-sheani-zocher", "our-trip-to-aran"],
  },
];
const grouped = groups.map((group) => ({
  title: group.title,
  stories: group.slugs.flatMap((slug) => {
    const story = stories.find((entry) => entrySlug(entry.id) === slug);
    return story ? [story] : [];
  }),
}));
const groupedSlugs = new Set(groups.flatMap((group) => group.slugs));
const otherStories = stories.filter((story) => !groupedSlugs.has(entrySlug(story.id)));
const essays = [
  {
    title: "ועכשיו: מלחמת אזרחים",
    href: "https://www.zman.co.il/609321/",
  },
  {
    title: "איה קרני?",
    href: "https://www.zman.co.il/731318/",
  },
];
---

<BaseLayout title="סיפורים" current="stories">
  <div class="container">
    <h1 class="page-title">סיפורים</h1>
    {
      stories.length === 0 ? (
        <p class="item-meta">עדיין לא פורסמו סיפורים.</p>
      ) : (
        <>
          {grouped.map((group) => (
            <section class="story-group">
              <h2 class="section-subhead">{group.title}</h2>
              <ul class="section-list">
                {group.stories.map((story) => (
                  <li>
                    <a
                      href={withBase(`stories/${entrySlug(story.id)}/`)}
                      data-comment-title
                      data-kind="story"
                      data-slug={entrySlug(story.id)}
                    >
                      {story.data.title}
                    </a>
                    {story.data.summary && (
                      <span class="item-summary" data-piece-summary hidden>
                        {story.data.summary}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))}
          <section class="story-group">
            <h2 class="section-subhead">פובליציסטיקה</h2>
            <ul class="section-list">
              {essays.map((essay) => (
                <li>
                  <a href={essay.href} target="_blank" rel="noopener noreferrer">
                    {essay.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
          {otherStories.length > 0 && (
            <ul class="section-list section-list--rest">
              {otherStories.map((story) => (
                <li>
                  <a
                    href={withBase(`stories/${entrySlug(story.id)}/`)}
                    data-comment-title
                    data-kind="story"
                    data-slug={entrySlug(story.id)}
                  >
                    {story.data.title}
                  </a>
                  {story.data.summary && (
                    <span class="item-summary" data-piece-summary hidden>
                      {story.data.summary}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          )}
        </>
      )
    }
    <CommentHover kind="story" />
  </div>
</BaseLayout>
