---
import { getCollection, render } from "astro:content";
import BackToTop from "../../components/BackToTop.astro";
import PieceEngagement from "../../components/PieceEngagement.astro";
import NotesToc from "../../components/NotesToc.astro";
import ProseLayout from "../../layouts/ProseLayout.astro";
import { filterPublished, entrySlug, withBase } from "../../lib/content";
import { HAKDAMA_SLUG, hakdamaToc } from "../../lib/notes-toc";

export async function getStaticPaths() {
  const notes = filterPublished(await getCollection("notes"));
  return notes.map((note) => ({
    params: { slug: entrySlug(note.id) },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const { title, summary } = note.data;
const slug = entrySlug(note.id);
const showToc = slug === HAKDAMA_SLUG;
---

<ProseLayout title={title} summary={summary} section="notes" wide={showToc}>
  {showToc && <NotesToc noteSlug={slug} entries={hakdamaToc} />}
  <Content />
  {
    showToc && (
      <div class="section-comments">
        {
          hakdamaToc.map((entry, index) => (
            <PieceEngagement
              kind="note"
              slug={`${slug}--${entry.id}`}
              title={entry.title}
              readSlug={index === 0 ? slug : undefined}
              readTitle={index === 0 ? title : undefined}
              skipRead={index > 0}
            />
          ))
        }
      </div>
    )
  }
  {
    showToc && (
      <>
        <script is:inline>
          const essay = document.querySelector("[data-piece-body]");
          const holding = essay?.querySelector(".section-comments");
          if (essay && holding) {
            const forms = [...holding.querySelectorAll(":scope > .piece-engagement")];
            const headings = [...essay.querySelectorAll("h2[id]")].filter(
              (heading) => !heading.closest(".section-comments"),
            );
            headings.forEach((heading, index) => {
              const form = forms[index];
              if (!form) return;
              let last = heading;
              let next = heading.nextElementSibling;
              while (
                next &&
                next !== holding &&
                !(next.tagName === "H2" && next.id && !next.closest(".piece-engagement"))
              ) {
                last = next;
                next = next.nextElementSibling;
              }
              last.after(form);
            });
            holding.remove();
          }
        </script>
        <nav class="prose-footer-nav" aria-label="ניווט בעמוד">
          <a href="#top">↑ לראש העמוד</a>
          <span class="prose-footer-nav__sep" aria-hidden="true">·</span>
          <a href={withBase("notes/")}>תוכן העניינים</a>
        </nav>
        <BackToTop />
      </>
    )
  }
  {!showToc && (
    <PieceEngagement slot="after" kind="note" slug={slug} title={title} contained />
  )}
</ProseLayout>
