---
import { getCollection } from "astro:content";
import PieceEngagement from "../../components/PieceEngagement.astro";
import PieceGate from "../../components/PieceGate.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PoemParallel from "../../components/PoemParallel.astro";
import {
  entrySlug,
  formatPoetEnglishCredit,
  publishedContentEntries,
  withBase,
} from "../../lib/content";

export async function getStaticPaths() {
  const poems = publishedContentEntries(await getCollection("poems"));
  return poems.map((poem) => ({
    params: { slug: entrySlug(poem.id) },
    props: { poem },
  }));
}

const { poem } = Astro.props;
const slug = entrySlug(poem.id);
const {
  title,
  originalTitle,
  author,
  authorEn,
  authorBirth,
  authorDeath,
  pairLayout,
  altTitle,
  altPairs,
  pairs,
  footnote,
  footnoteOn,
  footnotes,
  epigraph,
  sourceLang,
} = poem.data;
const poetEnglish = authorEn
  ? formatPoetEnglishCredit(authorEn, authorBirth, authorDeath, {
      deathAsterisk: Boolean(footnote) && footnoteOn === "death",
      nameAsterisk: Boolean(footnote) && footnoteOn === "author",
    })
  : null;
const displayTitle =
  footnote && footnoteOn === "title" ? `${title}*` : title;
const pageUrl = Astro.site
  ? new URL(withBase(`translations/${slug}/`), Astro.site).href
  : withBase(`translations/${slug}/`);
---

<BaseLayout title={title} current="translations" printUrl={pageUrl}>
  <div class="container container--wide">
    <header class="poem-header">
      <div class="poem-print-bar">
        <button type="button" class="poem-print" data-poem-print>
          <svg
            class="poem-print__icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M6 9V3h12v6"></path>
            <path
              d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"
            ></path>
            <rect x="6" y="14" width="12" height="7"></rect>
          </svg>
          <span class="visually-hidden">הדפסה</span>
        </button>
      </div>
      <h1 class="page-title">{displayTitle}</h1>
      <p class="poem-meta">
        {originalTitle && <span>{originalTitle} · </span>}
        {
          footnote && footnoteOn === "author" ? (
            <span>
              {author}
              <span aria-hidden="true">*</span>
            </span>
          ) : (
            author
          )
        }
      </p>
      {
        poetEnglish && (
          <p class="poem-meta poem-meta--en" dir="ltr" lang="en">
            {poetEnglish}
          </p>
        )
      }
    </header>
    <PieceGate />
    <div data-piece-body data-poem-sheet hidden>
    {
      epigraph && (
        <blockquote class="poem-epigraph">
          <div class="poem-epigraph__row">
            <p class="poem-cell poem-cell--la" dir="ltr" lang="en">
              {epigraph.original}
            </p>
            <p class="poem-cell poem-cell--he" dir="rtl" lang="he">
              {epigraph.translation}
            </p>
          </div>
          {(epigraph.attribution || epigraph.attributionHe) && (
            <div class="poem-epigraph__row poem-epigraph__attr">
              <p class="poem-cell poem-cell--la" dir="ltr" lang="en">
                {epigraph.attribution && `—${epigraph.attribution}`}
              </p>
              <p class="poem-cell poem-cell--he" dir="rtl" lang="he">
                {epigraph.attributionHe && `–${epigraph.attributionHe}`}
              </p>
            </div>
          )}
        </blockquote>
      )
    }
    <PoemParallel
      pairs={pairs}
      layout={pairLayout}
      altTitle={altTitle}
      altPairs={altPairs}
      sourceLang={sourceLang}
    />
    {
      footnote && (
        <p class="poem-footnote">*{footnote}</p>
      )
    }
    {
      footnotes && footnotes.length > 0 && (
        <ol class="poem-footnotes">
          {footnotes.map((note) => (
            <li>{note}</li>
          ))}
        </ol>
      )
    }
    {
      author !== "חנן קוביצקי" && (
        <p class="poem-print-credit">
          תרגום: חנן קוביצקי
          <span class="poem-print-credit__url" dir="ltr">{pageUrl}</span>
        </p>
      )
    }
    </div>
    <PieceEngagement kind="poem" slug={slug} title={title} />
    <script>
      const sheet = document.querySelector<HTMLElement>("[data-poem-sheet]");
      const header = document.querySelector<HTMLElement>(".poem-header");
      const pageContentPx = ((297 - 14 - 16) / 25.4) * 96;
      const printWidthPx = ((210 - 28) / 25.4) * 96;

      const fitSteps = [
        { line: "1.5", spacer: "1.5rem", header: "2.5rem" },
        { line: "1.4", spacer: "1.15rem", header: "2rem" },
        { line: "1.32", spacer: "0.85rem", header: "1.6rem" },
        { line: "1.24", spacer: "0.6rem", header: "1.25rem" },
        { line: "1.16", spacer: "0.4rem", header: "1rem" },
      ];

      const applyFit = (step: (typeof fitSteps)[number] | null) => {
        const root = document.documentElement;
        if (!step) {
          root.classList.remove("poem-tight");
          root.style.removeProperty("--print-fit-line");
          root.style.removeProperty("--print-fit-spacer");
          root.style.removeProperty("--print-fit-header");
          return;
        }
        root.classList.add("poem-tight");
        root.style.setProperty("--print-fit-line", step.line);
        root.style.setProperty("--print-fit-spacer", step.spacer);
        root.style.setProperty("--print-fit-header", step.header);
      };

      const measureProbe = (step: (typeof fitSteps)[number]) => {
        const probe = document.createElement("div");
        probe.className = "poem-print-measure";
        probe.style.cssText = `position:absolute;left:-10000px;top:0;width:${printWidthPx}px;visibility:hidden;pointer-events:none;`;
        probe.style.setProperty("--poem-line-height-he", step.line);
        probe.style.setProperty("--poem-line-height-la", step.line);
        probe.style.setProperty("--print-fit-spacer", step.spacer);
        probe.style.setProperty("--print-fit-header", step.header);
        if (header) {
          const headerClone = header.cloneNode(true);
          if (headerClone instanceof HTMLElement) {
            headerClone.querySelector(".poem-print-bar")?.remove();
            probe.append(headerClone);
          }
        }
        const sheetClone = sheet?.cloneNode(true);
        if (sheetClone instanceof HTMLElement) {
          sheetClone.hidden = false;
          probe.append(sheetClone);
        }
        document.body.append(probe);
        const blocks = [
          ...probe.querySelectorAll<HTMLElement>(
            ".poem-header, .poem-row, .poem-footnote, .poem-footnotes, .poem-epigraph, .poem-print-credit",
          ),
        ].filter((block) => !block.closest(".poem-header") || block.classList.contains("poem-header"));
        const pages: number[] = [];
        let used = 0;
        let lines = 0;
        const closePage = () => {
          pages.push(lines);
          used = 0;
          lines = 0;
        };
        for (const block of blocks) {
          const height = block.offsetHeight;
          if (used > 0 && used + height > pageContentPx) closePage();
          used += height;
          if (
            block.classList.contains("poem-row") &&
            !block.classList.contains("poem-row--spacer")
          ) {
            lines += 1;
          }
        }
        if (used > 0) pages.push(lines);
        const height = probe.scrollHeight;
        probe.remove();
        return {
          height,
          loneLine: pages.some((count, index) => index > 0 && count === 1),
        };
      };

      const fitLoneLines = () => {
        if (!sheet || sheet.hidden) {
          applyFit(null);
          return;
        }
        applyFit(null);
        for (const step of fitSteps) {
          const { loneLine } = measureProbe(step);
          if (!loneLine) {
            applyFit(step.line === "1.5" ? null : step);
            return;
          }
        }
        applyFit(fitSteps[fitSteps.length - 1]);
      };

      const markMultipage = () => {
        if (!sheet || sheet.hidden) {
          document.documentElement.classList.remove("poem-multipage");
          return;
        }
        const { height } = measureProbe(
          fitSteps.find((step) => step.line === document.documentElement.style.getPropertyValue("--print-fit-line")) ??
            fitSteps[0],
        );
        document.documentElement.classList.toggle(
          "poem-multipage",
          height > pageContentPx,
        );
      };

      document
        .querySelector("[data-poem-print]")
        ?.addEventListener("click", () => {
          fitLoneLines();
          markMultipage();
          window.print();
        });
      window.addEventListener("beforeprint", () => {
        fitLoneLines();
        markMultipage();
      });
      if (sheet) {
        new MutationObserver(markMultipage).observe(sheet, {
          attributes: true,
          attributeFilter: ["hidden"],
        });
      }
      markMultipage();
    </script>
  </div>
</BaseLayout>
