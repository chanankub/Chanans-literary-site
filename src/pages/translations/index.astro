---
import { getCollection, type CollectionEntry } from "astro:content";
import CommentHover from "../../components/CommentHover.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  formatPoetEnglishCredit,
  publishedContentEntries,
  sortPoemsByAuthorBirth,
  withBase,
  entrySlug,
} from "../../lib/content";

type Poem = CollectionEntry<"poems">;

const poems = sortPoemsByAuthorBirth(
  publishedContentEntries(await getCollection("poems")),
);

/** Listed first, and not again under the poet. */
const memorialOrder = ["germania-gmar-cheshbon", "prida"];

/** Songs, in this order, and not again under the poet. */
const sungOrder = [
  "o-mar",
  "you-want-it-darker",
  "one-more-cup-of-coffee",
  "fire-and-rain",
  "shir-bokrim",
];

/** Beat poets, in this order, and not again under the poet. */
const beatOrder = [
  "kaddish",
  "i-am-waiting",
  "constantly-risking-absurdity",
  "jail-poems",
  "arbaa-shirim",
  "death",
];

/** High modernists, in birth order, and not again under the poet. */
const modernistPoets = [
  "Gertrude Stein",
  "Wallace Stevens",
  "Mina Loy",
  "William Carlos Williams",
  "Marianne Moore",
  "E. E. Cummings",
];

/** Objectivists, in birth order, and not again under the poet. */
const objectivistPoets = ["Lorine Niedecker", "Cid Corman"];

/** Confessional poets, in birth order, and not again under the poet. */
const confessionalPoets = [
  "John Berryman",
  "Robert Lowell",
  "Anne Sexton",
  "Sylvia Plath",
];

/** Poems from languages other than English, in this order, and not again under the poet. */
const otherLanguagesOrder = [
  "agalat-hachayim",
  "tam-o-shanter",
  "when-i-go-alone-at-night",
  "clouds-and-waves",
  "mein-blaues-klavier",
  "krokodil",
  "weltende",
  "avnei-negaf",
  "cancion-de-cuna",
  "optimistic-man",
  "the-strangest-creature-on-earth",
  "oda-al-gato",
  "hi-bat-hamesh-esreh",
];

function poetKey(poem: Poem): string {
  return poem.data.authorEn || poem.data.author;
}

function majorityAuthor(group: Poem[]): string {
  const counts = new Map<string, number>();
  for (const poem of group) {
    counts.set(poem.data.author, (counts.get(poem.data.author) ?? 0) + 1);
  }
  return [...counts.entries()].sort((a, b) => b[1] - a[1])[0][0];
}

function yearSpan(group: Poem[]): string | null {
  const dated = group.find(
    (poem) => poem.data.authorBirth != null || poem.data.authorDeath != null,
  );
  if (!dated) return null;
  const { authorBirth: birth, authorDeath: death } = dated.data;
  if (birth != null && death != null) return `${birth}–${death}`;
  if (birth != null) return `${birth}–`;
  if (death != null) return `–${death}`;
  return null;
}

function englishCredit(group: Poem[]): string | null {
  const named = group.find((poem) => poem.data.authorEn);
  if (!named?.data.authorEn) return null;
  const dated =
    group.find(
      (poem) => poem.data.authorBirth != null || poem.data.authorDeath != null,
    ) ?? named;
  return formatPoetEnglishCredit(
    named.data.authorEn,
    dated.data.authorBirth,
    dated.data.authorDeath,
  );
}

type Credit = { poem: Poem; author: string; authorEn: string | null };

type Block =
  | { type: "poems"; poems: Poem[] }
  | {
      type: "group";
      name: string;
      dates: string | null;
      english: string | null;
      credit?: boolean;
      poems: Poem[];
      credits?: Credit[];
    };

function poemsInOrder(slugs: string[]): Poem[] {
  return slugs.flatMap((slug) => {
    const poem = poems.find((item) => entrySlug(item.id) === slug);
    return poem ? [poem] : [];
  });
}

/** First poem by a poet keeps the dates; later ones keep both names only. */
function creditsFor(list: Poem[]): Credit[] {
  const seen = new Set<string>();
  return list.map((poem) => {
    const key = poetKey(poem);
    const first = !seen.has(key);
    seen.add(key);
    const authorEn = poem.data.authorEn
      ? first
        ? formatPoetEnglishCredit(
            poem.data.authorEn,
            poem.data.authorBirth,
            poem.data.authorDeath,
          )
        : poem.data.authorEn
      : null;
    return { poem, author: poem.data.author, authorEn };
  });
}

function poemsByPoets(names: string[]): Poem[] {
  const keys = new Set(names);
  return poems.filter((poem) => keys.has(poetKey(poem)));
}

const memorial = poemsInOrder(memorialOrder);
const sung = poemsInOrder(sungOrder);
const beat = poemsInOrder(beatOrder);
const otherLanguages = poemsInOrder(otherLanguagesOrder);
const modernists = poemsByPoets(modernistPoets);
const objectivists = poemsByPoets(objectivistPoets);
const confessionals = poemsByPoets(confessionalPoets);
const chanan = poems.filter(
  (poem) =>
    poetKey(poem) === "Chanan Kubitsky" &&
    !memorialOrder.includes(entrySlug(poem.id)),
);
const reserved = new Set([
  ...memorialOrder,
  ...sungOrder,
  ...beatOrder,
  ...otherLanguagesOrder,
  ...modernists.map((poem) => entrySlug(poem.id)),
  ...objectivists.map((poem) => entrySlug(poem.id)),
  ...confessionals.map((poem) => entrySlug(poem.id)),
  ...chanan.map((poem) => entrySlug(poem.id)),
]);
const rest = poems.filter((poem) => !reserved.has(entrySlug(poem.id)));

const blocks: Block[] = [];
if (memorial.length > 0) {
  blocks.push({
    type: "group",
    name: "לזכרן",
    dates: null,
    english: null,
    poems: memorial,
  });
}
if (chanan.length > 0) {
  blocks.push({
    type: "group",
    name: majorityAuthor(chanan),
    dates: yearSpan(chanan),
    english: englishCredit(chanan),
    poems: chanan,
  });
}

function pushCreditGroup(name: string, list: Poem[]) {
  if (list.length === 0) return;
  blocks.push({
    type: "group",
    name,
    dates: null,
    english: null,
    credit: true,
    poems: list,
    credits: creditsFor(list),
  });
}

function appendPoetGroups(list: Poem[]) {
  const byPoet = new Map<string, Poem[]>();
  for (const poem of list) {
    const key = poetKey(poem);
    const group = byPoet.get(key) ?? [];
    group.push(poem);
    byPoet.set(key, group);
  }
  const emitted = new Set<string>();
  let loose: Poem[] = [];
  const flushLoose = () => {
    if (loose.length === 0) return;
    blocks.push({ type: "poems", poems: loose });
    loose = [];
  };
  for (const poem of list) {
    const key = poetKey(poem);
    const group = byPoet.get(key) ?? [];
    if (group.length >= 2) {
      if (emitted.has(key)) continue;
      flushLoose();
      emitted.add(key);
      blocks.push({
        type: "group",
        name: majorityAuthor(group),
        dates: yearSpan(group),
        english: englishCredit(group),
        poems: group,
      });
    } else {
      loose.push(poem);
    }
  }
  flushLoose();
}

const early = rest.filter(
  (poem) => (poem.data.authorBirth ?? Number.MAX_SAFE_INTEGER) < 1874,
);
const later = rest.filter(
  (poem) => (poem.data.authorBirth ?? Number.MAX_SAFE_INTEGER) >= 1874,
);
appendPoetGroups(early);
pushCreditGroup("מודרניסטים", modernists);
pushCreditGroup("אובייקטיביסטים", objectivists);
pushCreditGroup("דור הביט", beat);
pushCreditGroup("שירה וידויית", confessionals);
appendPoetGroups(later);
pushCreditGroup("שפות אחרות", otherLanguages);
pushCreditGroup("שירים מולחנים", sung);
---

<BaseLayout title="שירה ותרגומים" current="translations">
  <div class="container">
    <h1 class="page-title">שירה ותרגומים</h1>
    {
      poems.length === 0 ? (
        <p class="item-meta">עדיין לא פורסמו תרגומים.</p>
      ) : (
        blocks.map((block) =>
          block.type === "group" ? (
            <section class="story-group">
              <h2 class="section-subhead">
                <span class="section-subhead__name">{block.name}</span>
                {block.english ? (
                  <span class="section-subhead__en" lang="en">{block.english}</span>
                ) : (
                  block.dates && (
                    <span class="section-subhead__en">{block.dates}</span>
                  )
                )}
              </h2>
              <ul class="section-list">
                {(block.credits ?? block.poems.map((poem) => ({ poem, author: "", authorEn: null }))).map(
                  ({ poem, author, authorEn }) => (
                    <li>
                      <a
                        href={withBase(`translations/${entrySlug(poem.id)}/`)}
                        data-comment-title
                        data-kind="poem"
                        data-slug={entrySlug(poem.id)}
                      >
                        {poem.data.title}
                      </a>
                      {block.credit && (
                        <span class="item-meta">
                          {author}
                          {authorEn && (
                            <>
                              {" · "}
                              <span dir="ltr" lang="en">{authorEn}</span>
                            </>
                          )}
                        </span>
                      )}
                    </li>
                  ),
                )}
              </ul>
            </section>
          ) : (
            <ul class="section-list">
              {block.poems.map((poem) => (
                <li>
                  <a
                    href={withBase(`translations/${entrySlug(poem.id)}/`)}
                    data-comment-title
                    data-kind="poem"
                    data-slug={entrySlug(poem.id)}
                  >
                    {poem.data.title}
                  </a>
                  <span class="item-meta">
                    {poem.data.author}
                    {poem.data.authorEn && (
                      <>
                        {" · "}
                        <span dir="ltr" lang="en">
                          {formatPoetEnglishCredit(
                            poem.data.authorEn,
                            poem.data.authorBirth,
                            poem.data.authorDeath,
                          )}
                        </span>
                      </>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          ),
        )
      )
    }
    <CommentHover kind="poem" />
  </div>
</BaseLayout>
