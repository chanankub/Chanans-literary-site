---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/content";
---

<BaseLayout title="בית" current="home">
  <div class="container">
    <div class="home-intro">
      <h1 class="page-title">ברוכים הבאים לקוראים סקרנים</h1>
      <header class="home-author">
        <img
          src={withBase("images/chanan.png")}
          alt=""
          width="152"
          height="152"
        />
        <p class="home-author__name">שלכם, חנן קוביצקי</p>
      </header>
    </div>
    <nav aria-label="מדורים">
      <ul class="section-list">
        <li>
          <a href={withBase("about/")}>אודות</a>
        </li>
        <li>
          <a href={withBase("translations/")}>תרגומי שירה</a>
        </li>
        <li>
          <a href={withBase("stories/")}>סיפורים קצרים</a>
        </li>
        <li>
          <a href={withBase("notes/")}>איך למדתי לאהוב שירה</a>
        </li>
      </ul>
    </nav>
  </div>
</BaseLayout>
